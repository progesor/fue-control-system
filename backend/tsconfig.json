{
  "compilerOptions": {
    /* Temel Ayarlar */
    "target": "ES2022",                     // Kodumuzun derleneceği modern JavaScript sürümü
    "module": "CommonJS",                  // Node.js için standart modül sistemi
    "outDir": "./dist",                    // Derlenmiş JavaScript dosyalarının konulacağı klasör
    "rootDir": "./src",                    // Bizim yazacağımız TypeScript kodlarının bulunduğu klasör

    /* Uyumluluk Ayarları */
    "resolveJsonModule": true,             // JSON dosyalarını direkt import etmemizi sağlar (config.json için)
    "esModuleInterop": true,               // Farklı modül tipleri arasında uyumluluğu artırır

    /* Hata Kontrolü */
    "strict": true,                        // Tüm katı tip kontrolü kurallarını etkinleştirir
    "skipLibCheck": true,                  // Bağımlılıkların (node_modules) tip kontrolünü atlar

    /* Geliştirme Kolaylıkları */
    "sourceMap": true                      // Hata ayıklama (debugging) için kaynak haritaları oluşturur
  },
  "include": ["src/**/*"],                 // TypeScript'in hangi dosyaları derleyeceğini belirtir
  "exclude": ["node_modules"]              // Derleme dışında tutulacak dosyalar
}